# The Tailscale operator looks for a Secret named `operator-oauth` in its namespace.
# Create this secret manually (it contains credentials and must NOT be committed to git):
#
#   kubectl create secret generic operator-oauth \
#     --namespace tailscale \
#     --from-literal=client_id=<YOUR_CLIENT_ID> \
#     --from-literal=client_secret=<YOUR_CLIENT_SECRET>
#
# How to get the credentials:
#   1. Go to https://login.tailscale.com/admin/settings/trust-credentials
#   2. Click "+ Credential"
#   3. Set scopes: General > Services (Read/Write), Devices > Core (Read/Write), Keys > Auth Keys (Read/Write)
#   4. In the Tags box select "tag:k8s-operator"
#   5. Generate and copy the Client ID and Client Secret
#
# Required ACL additions (merge into your tailnet ACL policy):
#   "tagOwners": {
#     "tag:k8s-operator": ["autogroup:admin"],
#     "tag:k8s":          ["tag:k8s-operator"]
#   },
#   "autoApprovers": {
#     "services": {
#       "tag:k8s": ["tag:k8s"]
#     }
#   }
#
# This file is a reminder only — the actual secret is managed out-of-band.
